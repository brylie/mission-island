{
  "name": "mission-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "playtest": "vite --mode playtest --host 0.0.0.0 --port 5194 --strictPort",
    "workbench:reference": "node --experimental-strip-types scripts/workbench-reference.mjs",
    "dyes:generate": "node --experimental-strip-types scripts/dye-swatches.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:full": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --fix-type layout --max-warnings 0",
    "check:unused": "knip",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=\"server/*.ts\" --test-coverage-include=\"src/simulation/*.ts\" --test-coverage-include=\"src/{actions,aviation,charged-actions,crew-appearance,farm,ferry-repair,gate-repair,gull-thermals,interaction-options,jobs,reticle-target,soaring-guide,terrain,truck-pose,weather}.ts\" --test-coverage-include=\"src/worlds/starter/lift.ts\" --test-coverage-include=\"src/residents/*.ts\" --test-coverage-include=\"src/worlds/starter/residents/*.ts\" --test-coverage-include=\"src/interactions/*.ts\" --test-coverage-include=src/resident-notices.ts --test-coverage-include=src/second-island/walking.ts --test-coverage-include=\"src/{biome-model,biome-navigation,biome-recipe,juniper-habitat}.ts\" --test-coverage-include=src/wind.ts --test-coverage-include=\"src/audio/{bird-calls,bird-recipes,dsp,engine,foliage-contact,foliage-recipes,footstep-recipes,gait,impact-inbox,loop-voice,mix,motor-recipes,recipe-kit,recipe-renderer,recipes,shore,surf-player,surface,truck-engine,truck-engine-model,wind-model,wind-player,wind-recipes}.ts\" --test-coverage-include=\"src/journal/*.ts\" --test-coverage-include=src/gate-swell.ts --test-coverage-include=src/worlds/starter/island-remarks.ts --test-coverage-lines=81 --test-coverage-functions=81 --test-coverage-branches=81 test/*.test.mjs",
    "quality": "npm run quality:commit && npm run quality:push",
    "quality:commit": "npm run lint && npm run check && npm test",
    "quality:push": "npm run lint:full && npm run check:unused && npm run build",
    "audit": "npm audit --audit-level=high",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.37.1",
    "@babylonjs/core": "^9.0.0",
    "cannon-es": "^0.20.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^3.0.1",
    "knip": "^5.88.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
